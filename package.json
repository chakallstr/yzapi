{
  "name": "yapayzekalab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "rm -rf dist && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "postbuild": "cp .htaccess dist/.htaccess 2>/dev/null || true",
    "start": "node dist/server.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "itest": "vitest run --config vitest.itest.config.ts",
    "e2e": "playwright test --project=chromium",
    "e2e:up": "bash scripts/e2e-up.sh",
    "scan:public": "node scripts/scan-public-bundle.mjs",
    "qa:uat": "node scripts/yapayzekalab-uat-smoke.mjs",
    "smoke:vps": "node scripts/vps-smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:rotate-cipher": "tsx src/server/db/rotate-api-key-cipher.ts",
    "db:seed": "tsx src/server/db/seed.ts",
    "db:reset:users": "node scripts/reset-user-data.mjs --confirm",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d postgres",
    "deploy": "bash scripts/deploy.sh",
    "deploy:fast": "bash scripts/deploy.sh skip-build",
    "deploy:vps": "bash scripts/vps-deploy.sh",
    "preflight:live": "bash scripts/vps-live-preflight.sh",
    "ops:vps-status": "bash scripts/vps-ops-status.sh",
    "snapshot:live-state": "node scripts/live-state/snapshot.mjs"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "jose": "^6.2.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.8",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "pino-pretty": "^11.0.0",
    "postgres": "^3.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.8.1",
    "undici": "^8.3.0",
    "uuid": "^14.0.0",
    "vite": "^6.2.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/express": "^4.17.21",
    "@types/nock": "^10.0.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "fast-check": "^3.23.2",
    "nock": "^14.0.15",
    "playwright": "^1.60.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.7"
  }
}
