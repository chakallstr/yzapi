{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "e2e", "vite.config.ts", "vitest.config.ts", "vitest.itest.config.ts", "playwright.config.ts", "drizzle.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    ".deploy",
    ".backups",
    "_backups",
    "migration-audit",
    "tmp-account-deploy",
    "**/*.bak"
  ]
}
