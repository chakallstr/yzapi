[Unit]
Description=Gozcu external heartbeat watcher (yzapi)
Documentation=https://github.com/chakallstr/yzapi
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=turkapi
Group=turkapi
WorkingDirectory=/opt/turkapiprojesi
EnvironmentFile=/opt/turkapiprojesi/.env.production
# Uygulamadan bagimsiz: yalniz /health'i yoklar, OpenWA'ya dogrudan yazar.
ExecStart=/usr/bin/node /opt/turkapiprojesi/scripts/gozcu-heartbeat.mjs
# Bir tur takilirsa systemd zorla kessin (oneshot timer'i kilitlemesin).
TimeoutStartSec=30
