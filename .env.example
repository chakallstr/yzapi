# YapayZekaLab runtime
NODE_ENV=development
PORT=4567

# Database
DATABASE_URL=postgres://yzapi:yzapi_dev_pw@localhost:5432/yzapi

# Logging
LOG_LEVEL=info

# Optional legacy/demo AI key. Not used by the production /v1 proxy.
GEMINI_API_KEY=

# ── Admin Auth ────────────────────────────────────────────
# Admin paneli ayrı şifre kullanmaz. Yetkili hesap: cix.crazy666@gmail.com

# ── JWT ───────────────────────────────────────────────────
# Required — must be at least 32 characters
JWT_SECRET=change_me_to_a_random_32_plus_chars_secret
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# Encrypts stored full API keys (for Telegram re-delivery). REQUIRED in
# production and MUST differ from JWT_SECRET — otherwise a JWT_SECRET leak also
# decrypts every stored API key. At least 32 chars. In dev/test it falls back to
# JWT_SECRET. Rotating this value: set the previous value in
# API_KEY_ENCRYPTION_SECRET_OLD, run `npm run db:rotate-cipher -- --confirm`,
# then remove the OLD var once all rows are rotated.
API_KEY_ENCRYPTION_SECRET=replace-with-32-char-server-only-secret-distinct-from-jwt
# Only set during a rotation window (previous API_KEY_ENCRYPTION_SECRET value).
# API_KEY_ENCRYPTION_SECRET_OLD=

# Minutes before an unsettled usage reservation is treated as orphan and
# refunded by the reaper job (covers crash/OOM/deploy between reserve and settle).
ORPHAN_RESERVATION_GRACE_MIN=15

# ── Google OAuth (optional) ───────────────────────────────
# Leave empty for development — /api/auth/google returns 503 if unset
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4567/api/auth/google/callback

# ── Frontend ──────────────────────────────────────────────
APP_BASE_URL=http://localhost:4567
FRONTEND_AUTH_RETURN=/

# WhatsApp OTP after Google auth (OpenWA)
WHATSAPP_OTP_ENABLED=false
WHATSAPP_OTP_PROVIDER=openwa
WHATSAPP_OTP_DRY_RUN=false
# REQUIRED in production when WHATSAPP_OTP_ENABLED=true, and MUST differ from
# JWT_SECRET. At least 32 chars. Falls back to JWT_SECRET in dev/test only.
WHATSAPP_OTP_HASH_SECRET=replace-with-32-char-server-only-secret
WHATSAPP_OTP_TTL_SEC=300
WHATSAPP_OTP_RESEND_COOLDOWN_SEC=60
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_OTP_MAX_SENDS_PER_PHONE_HOUR=5
WHATSAPP_OTP_MAX_SENDS_PER_IP_HOUR=20
OPENWA_API_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# ── AI Provider Proxy ─────────────────────────────────────
# Active upstream provider: Claude Popusk (OpenAI-compatible, Bearer auth).
# Base URL ends with /v1; model ids are plain catalog ids (no provider prefix).
# Leave AI_PROVIDER_API_KEY empty to disable the proxy (returns 503 when unset).
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.claude-popusk.shop/v1
# Legacy CLOSEROUTER_* are only a fallback when AI_PROVIDER_* are empty. Leave
# blank in production. (The previous local OmniRoute override lived here — do NOT
# point these at 127.0.0.1:20128 again; it has no provider credentials.)
CLOSEROUTER_API_KEY=
CLOSEROUTER_BASE_URL=
# Per-API-key request rate limit per minute (default: 60)
RATE_LIMIT_PER_KEY_PER_MIN=60

# ── Shopier (card payments — optional) ────────────────────
# Leave empty — /api/payments/shopier/init returns 503 if unset
# These are legacy checkout-form credentials for api_pay4.php, not a PAT/JWT.
SHOPIER_API_KEY=
SHOPIER_API_SECRET=
SHOPIER_RETURN_URL=http://localhost:4567/api/payments/shopier/callback
# Optional relay target when Shopier OSB is global and must keep an existing service alive.
SHOPIER_OSB_FALLBACK_URL=

# ── Cryptomus (USDT TRC20 — optional) ─────────────────────
# Leave empty — /api/payments/crypto/init returns 503 if unset
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
CRYPTOMUS_RETURN_URL=http://localhost:4567/api/payments/crypto/callback
CRYPTOMUS_WEBHOOK_URL=http://localhost:4567/api/payments/crypto/webhook

# ── Telegram + Crypto Pay bot channel (optional) ───────────
# Telegram webhook should set X-Telegram-Bot-Api-Secret-Token to this secret.
# REQUIRED in production: if empty while NODE_ENV=production, the webhook rejects
# all updates (the bot will not work). Set this and configure the same value via
# Telegram setWebhook secret_token.
TELEGRAM_BOT_TOKEN=
# Bot username WITHOUT @ (e.g. YapayZekaLabAPIBot). REQUIRED for the account-link
# deep link (t.me/<username>?start=link_<code>); if empty the "bağla" flow cannot
# open the bot and linking silently fails. Falls back to getMe() if unset.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SUPPORT_URL=
# Crypto Pay token comes from @CryptoBot -> Crypto Pay -> Create App.
CRYPTO_PAY_API_TOKEN=
CRYPTO_PAY_API_BASE_URL=https://pay.crypt.bot
CRYPTO_PAY_WEBHOOK_SECRET=
CRYPTO_PAY_RETURN_URL=http://localhost:4567/?payment=telegram_crypto
CRYPTO_PAY_ACCEPTED_ASSETS=USDT,TON,BTC,ETH,LTC,BNB,TRX,USDC
CRYPTO_PAY_INVOICE_EXPIRES_SEC=3600

# ── IBAN (bank transfer — always enabled) ─────────────────
IBAN_BANK_NAME=Garanti BBVA
IBAN_NUMBER=TR00 0000 0000 0000 0000 0000 00
IBAN_OWNER=YapayZekaLab Ltd.
PAYMENT_WHATSAPP_NUMBER=905000000000

# ── Manual crypto wallet instructions (non-secret display config) ─
# Optional fallback/manual review flow. Do not put API keys here.
CRYPTO_WALLET_ENABLED=false
CRYPTO_WALLET_ASSET=USDT
CRYPTO_WALLET_NETWORK=TRC20
CRYPTO_WALLET_ADDRESS=
CRYPTO_WALLET_MEMO=

# ── KDV / VAT rate ────────────────────────────────────────
KDV_RATE=0.20

# ── Email / payment notifications (optional) ──────────────
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
PAYMENT_NOTIFICATION_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
